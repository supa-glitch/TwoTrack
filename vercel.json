{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "fluid": true,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "pages/**"
    }
  },
  "redirects": [
    {
      "source": "/teacher",
      "destination": "/app",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/index?__page=auth/:path*"
    },
    {
      "source": "/app",
      "destination": "/api/index?__page=app"
    },
    {
      "source": "/board",
      "destination": "/api/index?__page=board"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
